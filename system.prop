########################################
# SuperMario Tweaker
# By: MRX7014
########################################

########################################
# Activity Manager
########################################
persist.device_config.activity_manager.max_cached_processes=32
persist.sys.fflag.override.settings_enable_monitor_phantom_procs=false
ro.config.max_starting_bg=8

########################################
# Dalvik VM
########################################
dalvik.vm.heapstartsize=8m
dalvik.vm.heapgrowthlimit=128m
dalvik.vm.heapsize=512m
dalvik.vm.heaptargetutilization=0.75
dalvik.vm.heapminfree=2m
dalvik.vm.heapmaxfree=8m

########################################
# ART / Dex Optimization
########################################
pm.dexopt.install=speed-profile
pm.dexopt.bg-dexopt=speed-profile
pm.dexopt.ab-ota=speed-profile
pm.dexopt.first-boot=verify
pm.dexopt.boot-after-ota=verify

########################################
# Low Memory Killer (LMKD)
########################################
ro.lmk.enable_adaptive_lmk=false
ro.lmk.use_psi=true
ro.lmk.low=1001
ro.lmk.medium=1001
ro.lmk.critical=900
ro.lmk.critical_upgrade=false
ro.lmk.kill_heaviest_task=false
ro.lmk.kill_timeout_ms=100
ro.lmk.swap_util_max=100
ro.lmk.swap_free_low_percentage=5
ro.lmk.thrashing_limit=100
ro.lmk.thrashing_limit_decay=10
ro.lmk.psi_partial_stall_ms=200
ro.lmk.psi_complete_stall_ms=700

########################################
# Graphics & HWUI
########################################
debug.hwui.skia_atrace_enabled=false

########################################
# Device Configuration
########################################
ro.config.low_ram=false