# SuperMario Tweaker
### By: MRX7014

# build.prop tweaks

# Faster Boot Time & Power Optimization
ro.config.hw_power_saving=1
ro.config.hw_fast_dormancy=1
ro.config.hw_quickpoweron=true
ro.mot.eri.losalert.delay=1000
ro.ril.sensor.sleep.control=1

# Tweaks
ro.sys.fw.bg_apps_limit=64
persist.device_config.activity_manager.max_cached_processes=128
persist.device_config.activity_manager.use_compaction=false
ro.lmk.kill_heaviest_task=false
ro.config.max_phantom_processes=2147483647
ro.config.max_starting_bg=32
ro.config.use_freezer=false
persist.sys.freezer.enable=false
dalvik.vm.heapgrowthlimit=128m
dalvik.vm.heapstartsize=8m
dalvik.vm.heapsize=512m
dalvik.vm.heaptargetutilization=0.75
dalvik.vm.heapminfree=2m
dalvik.vm.heapmaxfree=8m
ro.lmk.enable_adaptive_lmk=false
ro.lmk.low=1001
ro.lmk.medium=1001
ro.lmk.critical=900
ro.lmk.critical_upgrade=false
ro.lmk.kill_heaviest_task=false
ro.lmk.kill_timeout_ms=100
ro.lmk.swap_util_max=100
ro.lmk.swap_free_low_percentage=5
ro.lmk.thrashing_limit=100
ro.lmk.thrashing_limit_decay=10
ro.lmk.psi_partial_stall_ms=200
ro.lmk.psi_complete_stall_ms=700
